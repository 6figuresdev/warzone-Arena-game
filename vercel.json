{
  "framework": "vite",
  "buildCommand": "node tools/restore-assets.mjs && node tools/check-assets.mjs && vite build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(models|tex|hdr)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
